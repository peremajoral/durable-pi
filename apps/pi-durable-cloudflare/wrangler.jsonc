{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-durable-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  // DPI_TOKEN is a secret: local dev reads it from .dev.vars (gitignored), a deploy from
  // `npx wrangler secret put DPI_TOKEN`. It must never live in this file.
  "observability": { "enabled": true }
}
